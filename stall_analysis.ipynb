def reorder_products(stock_data):
    """Return a list of products whose quantity is at or below the reorder level."""
    products = []
    for product, details in stock_data.items():
        if details["qty"] <= details["reorder"]:
            products.append(product)
    return products

products_to_reorder = reorder_products(stock)

gross_margins = {}

for product, details in stock.items():
    margin = ((details["price"] - details["cost"]) / details["price"]) * 100
    gross_margins[product] = margin

print("Products to reorder:", products_to_reorder)

for product, margin in gross_margins.items():
    print(f"{product}: {margin:.2f}% gross margin")
